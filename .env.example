# RemoteBot configuration template.
#
# Copy this file to .env and fill in your own values:
#     copy .env.example .env
#
# .env is gitignored and is never committed. This template is the only
# configuration file in the repository, and it is intentionally empty --
# never put a real bot token here.
#
# Lines starting with # are ignored. Keys are read once at startup, so
# restart the bot after editing.
#
# Formats, for reference:
#   DISCORD_BOT_TOKEN   the bot token from the Discord Developer Portal (required)
#   ALLOWED_CHANNEL_ID  channel snowflake, digits only; 0 or absent = any channel
#   ALLOWED_USER_IDS    comma-separated user snowflakes, digits only; empty = anyone
#   SHUTDOWN_DELAY      countdown seconds before a destructive action
#   TRIGGER_WORD        the exact word that opens the panel (required, case-sensitive)

DISCORD_BOT_TOKEN=
ALLOWED_CHANNEL_ID=
ALLOWED_USER_IDS=
SHUTDOWN_DELAY=
TRIGGER_WORD=
