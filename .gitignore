__pycache__
.pytest_cache

# Runtime artifacts. Safe to ignore: regenerated on every run.
bot.log*
watchdog.log*
helper.log
heartbeat
*.trigger
.exec_lock
bot_startup.log
dist/
build/
*.spec

# The real config, which holds the bot token. Only the blank .env.example
# template is tracked; see docs/CONFIGURATION.md.
.env
!.env.example